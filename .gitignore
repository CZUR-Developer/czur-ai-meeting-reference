# Operating-system files
.DS_Store
Thumbs.db

# IntelliJ IDEA / Android Studio
.idea/*
!.idea/.gitignore
!.idea/codeStyles/
!.idea/codeStyles/**
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/**
*.iml
*.iws
*.ipr

# Gradle
.gradle/
# Kotlin 编译器会话缓存由本机生成，Android Studio／命令行构建都不入库。
.kotlin/
build/
**/build/
out/
**/out/
target/
**/target/

# Android
local.properties
*.apk
*.aar
*.aab
*.apks
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Java / Kotlin
*.class
*.jar
*.war
*.ear
hs_err_pid*

# Gradle Wrapper binaries are required to reproduce the build.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Node / Web
node_modules/
dist/
coverage/
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo

# Native/tooling outputs
cmake-build-*/
compile_commands.json
__pycache__/
*.pyc

# Containers and local deployment overrides
docker-compose.override.yml
docker-compose.local.yml
.env
.env.*
!.env.example

# Secrets, credentials and local certificates
*.pem
*.key
*.p12
*.jks
*.keystore
credentials.json
secrets.yml
secrets.yaml

# Logs and local reports
*.log
reports/
tmp/

# Generated protocol and coverage reports
*.class
*.gcda
*.gcno

# IDE metadata that is safe to regenerate
.project
.classpath
.settings/
