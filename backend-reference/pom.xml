<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.czur.ai.meeting</groupId>
  <artifactId>backend-reference</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>CZUR AI Meeting reference backend</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.0</junit.version>
  </properties>
  <dependencies>
    <!--
      公开 Manifest JSON 边界使用显式 tree codec，拒绝未知/重复/缺失字段及
      数值强制转换。Jackson 类型只停留在 protocol.json 基础设施包，不进入
      领域对象或 application port。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.4</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.15.4</version>
    </dependency>
    <!--
      运行时唯一共享连接池。HikariCP 只位于数据库装配边界，不渗透到领域
      和 application port；连接池由 JdbcDatabaseRuntime 负责启动与关闭。
    -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
    </dependency>
    <!-- Hikari 使用 SLF4J；将其统一桥接到本参考后端已有的 JUL 分级日志。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>1.7.36</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      JDBC 适配器只依赖 javax.sql.DataSource 和 java.sql；驱动放在运行时边界，
      使核心领域仍可在没有数据库的环境中编译和执行单元测试。部署参考后端时
      必须把该驱动与应用一起打包，或由容器运行时提供同版本驱动。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.6.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
