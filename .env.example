# Copy to .env for local development. Never commit the populated file.

# 参考 Compose 的 database Profile 使用以下占位值；生产环境请注入外部
# PostgreSQL 地址和凭据，不要把填充后的 .env 提交到仓库。
DATABASE_URL=jdbc:postgresql://db:5432/meeting
DATABASE_USER=meeting
DATABASE_PASSWORD=change-me-locally
# pgjdbc 单次 socket 读超时（秒，正整数；默认 5）。同一池的健康探针和业务
# 查询都会受此值约束；它不是整个 readiness/catalog 检查的绝对总截止时间。
# JDBC URL 不得另带精确的 socketTimeout 参数（包括无等号形式）。
DATABASE_SOCKET_TIMEOUT_SECONDS=5
POSTGRES_DB=meeting
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change-me-locally

# reference-dev 固定凭据身份只用于本地演示，默认禁用。启用时 Token 必须通过
# Secret 注入且具有 32 到 4096 个 UTF-8 字节；不要把填充值提交到仓库。
REFERENCE_DEV_IDENTITY_ENABLED=false
REFERENCE_DEV_IDENTITY_BEARER_TOKEN=
REFERENCE_DEV_IDENTITY_SUBJECT_SCOPE=reference-user
REFERENCE_DEV_IDENTITY_ORGANIZATION_SCOPE=reference-organization
REFERENCE_DEV_IDENTITY_ROLES=USER
REFERENCE_DEV_IDENTITY_PERMISSIONS=meeting:create,meeting:stop,meeting:delete
REFERENCE_DEV_IDENTITY_AUDIENCE=ai-meeting-reference
REFERENCE_DEV_IDENTITY_CLIENT_ID=android-reference-app
REFERENCE_DEV_IDENTITY_ISSUED_AT=2026-01-01T00:00:00Z
REFERENCE_DEV_IDENTITY_EXPIRES_AT=2027-01-01T00:00:00Z
REFERENCE_DEV_IDENTITY_CREDENTIAL_ID=reference-credential-v1
# P5-4 参考 App 的终端用户登录。部署者同时填写这两项才开放登录；
# 成功后后端发放上面的固定演示 Bearer Token。不要把填写后的 .env 入库。
# 正式合作伙伴应替换身份实现，不使用这个单账号演示配置。
# REFERENCE_DEV_LOGIN_USERNAME=meeting-user
# REFERENCE_DEV_LOGIN_PASSWORD=

# 15-03 参考后端单部署配置。DB/身份配置也必须有效并显式启用，才可装配。
# 以下仅为 ASR-only 格式示例；分页密钥至少 32 UTF-8 字节，须由部署方的
# Secret 管理机制注入并跨重启保持稳定。不要把实际值提交到 .env.example。
AI_MEETING_DEPLOYMENT_SCOPE=reference-deployment
AI_MEETING_PROFILE_ID=reference-asr
AI_MEETING_PROFILE_REVISION=1
AI_MEETING_PROFILE_REQUIRED_CAPABILITIES=transcript.realtime
# 可选 Profile 能力和部署禁用能力：省略表示空集合，若设置则用逗号分隔非空能力码。
# 当前字幕档位只注册必选实时字幕。P5-5 听悟互译会话可将
# translation.realtime 加入 PROFILE_OPTIONAL_CAPABILITIES、权益和模型能力三项；
# 同一会议的翻译仍需后续标准译文事件与最终收口片接通，勿用于正式结果交付。
AI_MEETING_ENTITLEMENT_SUPPORTED_CAPABILITIES=transcript.realtime
AI_MEETING_ENTITLEMENT_MAX_DURATION_MS=3600000
AI_MEETING_ENTITLEMENT_GRANT_TTL_MS=600000
AI_MEETING_ENTITLEMENT_RESERVATION_TTL_MS=300000
AI_MEETING_MOCK_CAPABILITIES=transcript.realtime
# AI_MEETING_DISABLED_CAPABILITIES=...
# P5-2：显式登记 Android 直连模型能力；省略时沿用上面的 P2 Mock 配置。
# ASR-only 模型只写 transcript.realtime。若希望在本场能力决策中看到翻译、总结
# 被模型关闭，需先把两项列入 PROFILE_OPTIONAL_CAPABILITIES 和权益支持集合。
# AI_MEETING_MODEL_CAPABILITIES=transcript.realtime
# 听悟互译会话示例：
# AI_MEETING_PROFILE_OPTIONAL_CAPABILITIES=translation.realtime
# AI_MEETING_ENTITLEMENT_SUPPORTED_CAPABILITIES=transcript.realtime,translation.realtime
# AI_MEETING_MODEL_CAPABILITIES=transcript.realtime,translation.realtime
# 本场发言人是参考 Profile 的可选能力；启用时权益和模型两侧都需声明。
# AI_MEETING_ENTITLEMENT_SUPPORTED_CAPABILITIES=transcript.realtime,speaker.diarization.session
# AI_MEETING_MODEL_CAPABILITIES=transcript.realtime,speaker.diarization.session
AI_MEETING_ESTIMATED_DURATION_MS=600000
AI_MEETING_MAX_MEETING_DURATION_MS=3600000
AI_MEETING_MAX_AUDIO_FRAME_BYTES=32000
AI_MEETING_EVENT_REPLAY_WINDOW=100
# 可选，省略表示不声明音频补拉上限；显式 0 表示不允许补拉。
# AI_MEETING_MAX_REPLAY_AUDIO_MS=0
AI_MEETING_PAGE_TOKEN_SECRET=
# Docker 演示从 deploy/ 目录启动时，外部地址必须与映射端口一致。
API_PORT=8080
WSS_PORT=8443
AI_MEETING_WSS_ORIGIN=wss://localhost:8443
AI_MEETING_TLS_KEYSTORE_FILE=./local-meeting.p12
AI_MEETING_TLS_KEYSTORE_PASSWORD=
AI_MEETING_WSS_TOKEN_TTL_MS=300000
# 演示时填写上面的 Token、分页密钥和证书密码，并明确启用身份与 Create。
AI_MEETING_CREATE_ENABLED=false
# 参考结果页示例有效期为 24 小时；实际产品时长由部署方调整。
AI_MEETING_RESULT_LINK_TTL_MS=86400000

# P5-3 Artifact Store：file 沿用参考文件实现；s3 使用 S3 兼容对象存储。
# 两种模式只改变结果正文位置，数据库仍保存会议/Artifact 元数据，Web API 不变。
AI_MEETING_ARTIFACT_STORE=file
# file 模式在 Compose 中固定挂载 /var/lib/meeting/artifacts；本机直接运行时需自行设置。
AI_MEETING_ARTIFACT_ROOT=/var/lib/meeting/artifacts
# s3 模式填写对象存储地址、Region、Bucket 和部署方自己的访问密钥。
# 留空 endpoint 表示使用该 Region 的标准 S3 地址；自建服务示例为 http://minio.example.invalid:9000。
AI_MEETING_S3_ENDPOINT=
AI_MEETING_S3_REGION=
AI_MEETING_S3_BUCKET=
AI_MEETING_S3_PREFIX=artifacts/
AI_MEETING_S3_ACCESS_KEY_ID=
AI_MEETING_S3_SECRET_ACCESS_KEY=

# P5 听悟实时 CreateTask：只有显式 true 才开放 :modelSession。
# RAM 密钥只在后端注入；响应仅交付临时 MeetingJoinUrl 和 TaskId。不要提交实值。
AI_MEETING_TINGWU_ENABLED=false
AI_MEETING_TINGWU_CREATE_TASK_URL=https://tingwu.cn-beijing.aliyuncs.com/openapi/tingwu/v2/tasks
AI_MEETING_TINGWU_APP_KEY=
AI_MEETING_TINGWU_ACCESS_KEY_ID=
AI_MEETING_TINGWU_ACCESS_KEY_SECRET=

# P5 百炼文本总结：显式开启后才签发短期 Key；永久 Key 仅留在后端环境中。
# 完整使用须同时在 Profile、权益、模型能力中登记 summary.structured。
AI_MEETING_BAILIAN_SUMMARY_ENABLED=false
AI_MEETING_BAILIAN_APP_ID=
DASHSCOPE_API_KEY=
AI_MEETING_BAILIAN_TOKEN_TTL_SECONDS=300
# 可选：地区/测试环境的服务地址，正式部署请使用 HTTPS。
# AI_MEETING_BAILIAN_TOKEN_URL=https://dashscope.aliyuncs.com/api/v1/tokens
# AI_MEETING_BAILIAN_COMPLETION_BASE_URL=https://dashscope.aliyuncs.com/api/v1/apps
# 可选模型会话选择：省略时沿用上面的听悟开关。
# 选择第二格式样例时，由部署方提供实际的 ws(s) 服务；参考后端不托管该服务。
# AI_MEETING_MODEL_ADAPTER=sample-json-ws
# AI_MEETING_SAMPLE_JSON_WS_ENDPOINT=ws://192.0.2.10:19091/model
