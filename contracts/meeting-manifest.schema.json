{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/ai-meeting/v0.1/meeting-manifest.schema.json",
  "title": "AI Meeting Manifest",
  "description": "与模型厂商和对象存储实现无关的会议最终产物清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "meetingId",
    "manifestRevision",
    "profile",
    "status",
    "startedAt",
    "endedAt",
    "durationMs",
    "languages",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "meetingId": {
      "type": "string",
      "pattern": "^mtg_[A-Za-z0-9_-]+$",
      "maxLength": 1024
    },
    "manifestRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "profile": {
      "$ref": "#/$defs/profileRef"
    },
    "title": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "status": {
      "enum": ["READY", "READY_WITH_WARNINGS", "FAILED", "DELETION_PENDING", "DELETED"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:0000|9999)-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z|(?!(?:0000|9999)-)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:(?:0[0-9]|1[0-7]):[0-5][0-9]|18:00)))$",
      "description": "严格 RFC 3339 的 Instant 可逆子集；UTC canonical 年份限定为 0000..9999，边界年份 0000/9999 只允许 Z，0001..9998 允许最大正负 18:00 的合法 offset；禁止 24:00、闰秒和超过 9 位小数。"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:0000|9999)-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z|(?!(?:0000|9999)-)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:(?:0[0-9]|1[0-7]):[0-5][0-9]|18:00)))$",
      "description": "严格 RFC 3339 的 Instant 可逆子集；UTC canonical 年份限定为 0000..9999，边界年份 0000/9999 只允许 Z，0001..9998 允许最大正负 18:00 的合法 offset；禁止 24:00、闰秒和超过 9 位小数。"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "languages": {
      "$ref": "#/$defs/languages"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "targets"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 2,
          "pattern": "\\S"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "\\S"
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "type",
        "mediaType",
        "revision",
        "size",
        "checksum",
        "status",
        "createdAt"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "audio.original",
            "transcript.raw",
            "transcript.final",
            "translation.final",
            "speaker.session",
            "speaker.identity",
            "summary.structured",
            "summary.markdown",
            "chapters.structured",
            "action-items.structured",
            "presentation.capture",
            "export.file"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        },
        "language": {
          "type": ["string", "null"],
          "minLength": 2,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "status": {
          "enum": ["PENDING", "READY", "FAILED", "DELETED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:0000|9999)-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z|(?!(?:0000|9999)-)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:(?:0[0-9]|1[0-7]):[0-5][0-9]|18:00)))$",
          "description": "严格 RFC 3339 的 Instant 可逆子集；UTC canonical 年份限定为 0000..9999，边界年份 0000/9999 只允许 Z，0001..9998 允许最大正负 18:00 的合法 offset；禁止 24:00、闰秒和超过 9 位小数。"
        },
        "supersedesArtifactId": {
          "type": ["string", "null"],
          "pattern": "^art_[A-Za-z0-9_-]+$"
        },
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifactFailure"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "FAILED"}},
            "required": ["status"]
          },
          "then": {
            "required": ["failure"],
            "properties": {"failure": {"$ref": "#/$defs/artifactFailure"}}
          },
          "else": {
            "properties": {"failure": {"type": "null"}}
          }
        }
      ]
    },
    "artifactFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "code", "retryable", "diagnosticId"],
      "properties": {
        "domain": {
          "enum": ["MODEL", "STORAGE", "SUMMARY", "INTERNAL"]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnosticId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "capability", "messageKey"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "messageKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "diagnosticId": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
