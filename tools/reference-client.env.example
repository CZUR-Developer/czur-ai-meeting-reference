# 本机局域网参考后端配置模板。复制为 tools/reference-client.env 后填写，
# 只在本机使用；不要把填写后的文件提交到 Git。模型长期 Key 只放这里或
# 外部 Secret 注入，Android App 只接收服务端签发的短期材料。

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/meeting
DATABASE_USER=meeting
DATABASE_PASSWORD=change-me-locally
DATABASE_SOCKET_TIMEOUT_SECONDS=5

REFERENCE_DEV_IDENTITY_ENABLED=true
REFERENCE_DEV_IDENTITY_BEARER_TOKEN=replace-with-at-least-32-byte-token-0000
REFERENCE_DEV_IDENTITY_SUBJECT_SCOPE=reference-user
REFERENCE_DEV_IDENTITY_ORGANIZATION_SCOPE=reference-organization
REFERENCE_DEV_IDENTITY_ROLES=USER
REFERENCE_DEV_IDENTITY_PERMISSIONS=meeting:create,meeting:stop,meeting:delete
REFERENCE_DEV_IDENTITY_AUDIENCE=ai-meeting-reference
REFERENCE_DEV_IDENTITY_CLIENT_ID=android-reference-app
REFERENCE_DEV_IDENTITY_ISSUED_AT=2026-01-01T00:00:00Z
REFERENCE_DEV_IDENTITY_EXPIRES_AT=2027-01-01T00:00:00Z
REFERENCE_DEV_IDENTITY_CREDENTIAL_ID=reference-credential-v1
REFERENCE_DEV_LOGIN_USERNAME=meeting-user
REFERENCE_DEV_LOGIN_PASSWORD=replace-locally

AI_MEETING_HTTP_BIND=0.0.0.0:8080
AI_MEETING_DEPLOYMENT_SCOPE=reference-lan
AI_MEETING_PROFILE_ID=reference-profile
AI_MEETING_PROFILE_REVISION=1
AI_MEETING_PROFILE_REQUIRED_CAPABILITIES=transcript.realtime
AI_MEETING_ENTITLEMENT_SUPPORTED_CAPABILITIES=transcript.realtime
AI_MEETING_ENTITLEMENT_MAX_DURATION_MS=3600000
AI_MEETING_ENTITLEMENT_GRANT_TTL_MS=600000
AI_MEETING_ENTITLEMENT_RESERVATION_TTL_MS=300000
AI_MEETING_MODEL_CAPABILITIES=transcript.realtime
AI_MEETING_MODEL_LANGUAGES=zh-CN,en-US
AI_MEETING_ESTIMATED_DURATION_MS=600000
AI_MEETING_MAX_MEETING_DURATION_MS=3600000
AI_MEETING_MAX_AUDIO_FRAME_BYTES=32000
AI_MEETING_EVENT_REPLAY_WINDOW=100
AI_MEETING_PAGE_TOKEN_SECRET=replace-with-at-least-32-byte-page-secret-0000

# 客户端直连模式仍保留公开 Create 的兼容字段；本进程不会启动 WSS。
AI_MEETING_WSS_ORIGIN=wss://unused.invalid:8443
AI_MEETING_WSS_TOKEN_TTL_MS=300000
AI_MEETING_CREATE_ENABLED=true
AI_MEETING_REALTIME_RENEW_ENABLED=false
AI_MEETING_RESULT_LINK_TTL_MS=86400000

# file 是本机默认结果存储；目录需可写。可替换为 s3 并填写对应字段。
AI_MEETING_ARTIFACT_STORE=file
AI_MEETING_ARTIFACT_ROOT=.local/reference-artifacts

# 最小本机联调使用固定 JSON WebSocket Adapter；它不需要厂商密钥。
# 真实验证时将其改为 tingwu-realtime，并只在本机注入听悟凭据。
AI_MEETING_MODEL_ADAPTER=sample-json-ws
AI_MEETING_SAMPLE_JSON_WS_ENDPOINT=ws://127.0.0.1:19091/model

# 可选：声明翻译、总结或本场发言人时，必须同时把能力加入 Profile、权益和模型三处。
# AI_MEETING_PROFILE_OPTIONAL_CAPABILITIES=translation.realtime,summary.structured,speaker.diarization.session
# AI_MEETING_ENTITLEMENT_SUPPORTED_CAPABILITIES=transcript.realtime,translation.realtime,summary.structured,speaker.diarization.session
# AI_MEETING_MODEL_CAPABILITIES=transcript.realtime,translation.realtime,speaker.diarization.session
# AI_MEETING_MODEL_LANGUAGES=zh-CN,en-US,ja-JP,ko-KR,de-DE,fr-FR,ru-RU

# 百炼总结只在服务端配置；不要放入 Android 或 Git。
# AI_MEETING_BAILIAN_SUMMARY_ENABLED=true
# AI_MEETING_BAILIAN_APP_ID=
# DASHSCOPE_API_KEY=
