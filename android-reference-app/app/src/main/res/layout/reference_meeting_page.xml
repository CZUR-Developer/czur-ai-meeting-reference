<?xml version="1.0" encoding="utf-8"?>
<!-- 国内基准：dialog_transcription_setting、fragment_ai_trans[_subtitle]及会中Panel；
     dp/sp数值表示设计单位，ReferenceUiScale局部适配，不依赖Launcher或私有UILib。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reference_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/reference_background">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/setup_card" android:layout_width="988dp" android:layout_height="856dp"
                android:layout_gravity="center" android:orientation="vertical" android:background="@drawable/czur_ref_card">
                <LinearLayout android:id="@+id/setup_header" android:layout_width="match_parent" android:layout_height="86dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="54dp" android:paddingEnd="24dp"
                    android:background="@drawable/czur_ref_header">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="bottom" android:baselineAligned="true">
                        <TextView android:id="@+id/setup_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/reference_setup_title" android:textColor="#FFFFFF" android:textSize="48sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/setup_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="（实时将声音转文字）" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <Button android:id="@+id/account_button" style="@style/ReferenceHeaderButton" android:layout_width="100dp" android:layout_height="46dp"
                        android:text="@string/reference_account" />
                </LinearLayout>
                <ScrollView android:id="@+id/setup_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:fillViewport="true" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/setup_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="32dp" android:paddingBottom="8dp">
                        <RadioGroup android:id="@+id/mode_group" android:layout_width="588dp" android:layout_height="46dp" android:orientation="horizontal">
                            <RadioButton android:id="@+id/transcript_mode" style="@style/ReferenceModeButton" android:layout_width="286dp"
                                android:layout_height="match_parent" android:checked="true" android:text="AI会议纪要" />
                            <RadioButton android:id="@+id/translation_mode" style="@style/ReferenceModeButton" android:layout_width="286dp"
                                android:layout_height="match_parent" android:layout_marginStart="16dp" android:text="AI双语互译" />
                        </RadioGroup>
                        <TextView android:id="@+id/language_hint" style="@style/ReferenceLabel" android:layout_width="588dp" android:layout_height="wrap_content"
                            android:layout_marginTop="28dp" android:text="语言" android:textSize="30sp" android:textStyle="bold"/>
                        <LinearLayout android:id="@+id/language_selection_row" android:layout_width="588dp" android:layout_height="50dp"
                            android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:id="@+id/source_language_container" android:layout_width="0dp" android:layout_height="50dp"
                                android:layout_weight="1" android:orientation="vertical" android:background="@drawable/czur_ref_language_box">
                                <Spinner android:id="@+id/source_language" android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:background="@null" android:spinnerMode="dropdown" android:popupBackground="@drawable/czur_ref_language_box"/>
                            </LinearLayout>
                            <Button android:id="@+id/swap_languages" style="@style/ReferenceButton" android:layout_width="116dp" android:layout_height="50dp"
                                android:background="@null" android:drawableTop="@drawable/czur_ref_swap_languages"
                                android:contentDescription="交换会议语言" android:visibility="gone" />
                            <LinearLayout android:id="@+id/target_language_container" android:layout_width="0dp" android:layout_height="50dp"
                                android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:background="@drawable/czur_ref_language_box">
                                <Spinner android:id="@+id/target_language" android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:background="@null" android:spinnerMode="dropdown" android:popupBackground="@drawable/czur_ref_language_box"/>
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView android:id="@+id/translation_illustration" android:layout_width="588dp" android:layout_height="140dp"
                            android:layout_marginTop="8dp" android:src="@drawable/czur_ref_translation_illustration" android:scaleType="fitCenter"
                            android:contentDescription="两种语言的人群分坐左右两侧" android:visibility="gone"/>
                        <com.czur.aimeeting.reference.CzurReferenceSwitch android:id="@+id/summary_enabled" style="@style/ReferenceLabel"
                            android:layout_width="588dp" android:layout_height="48dp" android:layout_marginTop="24dp" android:paddingEnd="100dp"
                            android:text="生成会议纪要" android:textStyle="bold"/>
                        <com.czur.aimeeting.reference.CzurReferenceSwitch android:id="@+id/presentation_capture" style="@style/ReferenceLabel"
                            android:layout_width="588dp" android:layout_height="48dp" android:layout_marginTop="8dp" android:paddingEnd="100dp"
                            android:text="演示文稿(多模态)" android:textSize="30sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/presentation_hint" style="@style/ReferenceLabel" android:layout_width="588dp"
                            android:layout_height="wrap_content" android:textSize="23sp" android:text="将智能截取投屏内容，进行AI识别后，融入AI会议纪要。"/>
                        <View android:layout_width="888dp" android:layout_height="1dp" android:layout_marginTop="24dp" android:background="#D6D6D6"/>
                        <TextView style="@style/ReferenceLabel" android:layout_width="588dp" android:layout_height="wrap_content"
                            android:layout_marginTop="20dp" android:text="结果查看" android:textStyle="bold"/>
                        <RadioGroup android:id="@+id/result_group" android:layout_width="588dp" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/result_description" style="@style/ReferenceLabel" android:layout_width="588dp"
                            android:layout_height="wrap_content" android:textSize="20sp" android:padding="16dp"
                            android:background="@drawable/czur_ref_language_box" android:text="@string/reference_result_description"/>
                        <LinearLayout android:id="@+id/result_settings_host" android:layout_width="588dp" android:layout_height="wrap_content" android:orientation="vertical"/>
                    </LinearLayout>
                </ScrollView>
                <LinearLayout android:id="@+id/setup_footer" android:layout_width="match_parent" android:layout_height="114dp"
                    android:orientation="vertical" android:gravity="center" android:paddingBottom="16dp">
                    <Button android:id="@+id/start_meeting" style="@style/ReferenceButton" android:layout_width="180dp" android:layout_height="50dp"
                        android:text="开始" android:enabled="false"/>
                    <TextView style="@style/ReferenceLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:textSize="20sp" android:text="持续5分钟无字幕，自动停止"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/meeting_panel" android:layout_width="1800dp" android:layout_height="1008dp"
                android:layout_gravity="center" android:orientation="vertical" android:visibility="gone"
                android:background="@drawable/czur_ref_subtitle_background" android:padding="40dp">
                <TextView android:id="@+id/meeting_title" style="@style/ReferenceDarkLabel" android:layout_width="match_parent"
                    android:layout_height="38dp" android:gravity="center" android:textSize="28sp" android:text="AI字幕纪要"/>
                <!-- 仅必要截图消息占用一条简短提示；正常会议保持国内原有的简洁布局。 -->
                <TextView android:id="@+id/presentation_notice" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center" android:textSize="20sp"
                    android:textColor="@color/reference_translation" android:visibility="gone"/>
                <FrameLayout android:id="@+id/single_controls_slot" android:layout_width="match_parent" android:layout_height="76dp">
                    <LinearLayout android:id="@+id/meeting_controls" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center">
                        <TextView android:id="@+id/elapsed" style="@style/ReferenceDarkLabel" android:layout_width="210dp"
                            android:layout_height="44dp" android:textSize="22sp" android:gravity="center" android:text="00 : 00 : 00"/>
                        <com.czur.aimeeting.reference.ui.CzurVoiceLevelView android:id="@+id/voice_level" android:layout_width="136dp" android:layout_height="44dp"/>
                        <Button android:id="@+id/swap_columns" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="交换左右显示位置" android:visibility="gone"/>
                        <Button android:id="@+id/stop_meeting" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="停止会议" android:enabled="false"/>
                        <Button android:id="@+id/overlay_button" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="显示悬浮字幕"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:id="@+id/bilingual_header" android:layout_width="match_parent" android:layout_height="38dp"
                    android:orientation="horizontal" android:visibility="gone">
                    <TextView android:id="@+id/left_language_title" style="@style/ReferenceDarkLabel" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="22sp"/>
                    <Space android:layout_width="320dp" android:layout_height="match_parent"/>
                    <TextView android:id="@+id/right_language_title" style="@style/ReferenceDarkLabel" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="22sp"/>
                </LinearLayout>
                <ScrollView android:id="@+id/transcript_scroll" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/transcript_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </ScrollView>
                <LinearLayout android:id="@+id/bilingual_text_area" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
                    <ScrollView android:id="@+id/left_scroll" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                        <LinearLayout android:id="@+id/left_text_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    </ScrollView>
                    <FrameLayout android:id="@+id/bilingual_controls_slot" android:layout_width="320dp" android:layout_height="match_parent"/>
                    <ScrollView android:id="@+id/right_scroll" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                        <LinearLayout android:id="@+id/right_text_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    </ScrollView>
                </LinearLayout>
                <!-- 原诊断控件ID保留给历史接线，主产品界面不显示开发数据。 -->
                <TextView android:id="@+id/audio_level_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <ProgressBar android:id="@+id/audio_level" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="0dp" android:max="100" android:visibility="gone"/>
                <TextView android:id="@+id/capabilities" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/status" style="@style/ReferenceLabel" android:layout_width="match_parent" android:layout_height="38dp"
            android:layout_gravity="bottom" android:gravity="center" android:textSize="20sp" android:text="请先登录后开始会议"/>
        <LinearLayout android:id="@+id/result_retry_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center">
            <Button android:id="@+id/retry_result" style="@style/ReferenceButton" android:layout_width="200dp" android:layout_height="50dp"
                android:visibility="gone" android:text="重新打开结果"/>
            <Button android:id="@+id/end_result" style="@style/ReferenceSecondaryButton" android:layout_width="200dp" android:layout_height="50dp"
                android:layout_marginStart="24dp" android:visibility="gone" android:text="返回会前设置"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
