<?xml version="1.0" encoding="utf-8"?>
<!-- 会前使用完整 Activity 页面，沿用国内蓝白配色；会中 Panel 保留原有业务布局。
     dp/sp 数值表示 1920×1080 设计单位，ReferenceUiScale 局部适配，不依赖 Launcher 或私有 UILib。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reference_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/reference_setup_canvas">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/setup_card" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:paddingStart="80dp" android:paddingEnd="80dp"
                android:paddingTop="32dp" android:paddingBottom="32dp" android:background="@drawable/reference_setup_background">
                <!-- 顶部只保留返回、当前业务标题与账号入口，不承担会议状态或登录逻辑。 -->
                <LinearLayout android:id="@+id/setup_header" android:layout_width="match_parent" android:layout_height="104dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/setup_close" style="@style/ReferenceSetupBackButton" android:layout_width="wrap_content" android:layout_height="52dp" android:minWidth="112dp"
                        android:text="返回" android:contentDescription="返回上一页" />
                    <View android:layout_width="1dp" android:layout_height="48dp" android:layout_marginStart="24dp"
                        android:layout_marginEnd="28dp" android:background="@color/reference_setup_border" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/setup_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/reference_setup_title" android:textColor="@color/reference_setup_title"
                            android:textSize="40sp" android:textStyle="bold" android:includeFontPadding="false" />
                        <TextView android:id="@+id/setup_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="实时将声音转文字"
                            android:textColor="@color/reference_setup_muted" android:textSize="20sp" android:includeFontPadding="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/account_name" style="@style/ReferenceSetupHint" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:maxLines="1" android:ellipsize="end"
                        android:visibility="gone" />
                    <Button android:id="@+id/account_button" style="@style/ReferenceSetupSecondaryButton" android:layout_width="164dp" android:layout_height="52dp"
                        android:text="@string/reference_account" />
                </LinearLayout>
                <!-- 仅设置内容滚动；状态、开始和结果重试始终位于固定底部，插件增高不会挤走操作。 -->
                <ScrollView android:id="@+id/setup_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:layout_marginTop="28dp" android:fillViewport="true" android:overScrollMode="never"
                    android:scrollbarStyle="outsideOverlay" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/setup_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:baselineAligned="false" android:gravity="top">
                        <LinearLayout android:id="@+id/meeting_settings_card" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="2" android:orientation="vertical" android:padding="36dp"
                            android:background="@drawable/reference_setup_section">
                            <TextView style="@style/ReferenceSetupSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="会议设置" />
                            <TextView style="@style/ReferenceSetupHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" android:text="选择本场会议的模式与语言" />
                            <RadioGroup android:id="@+id/mode_group" android:layout_width="match_parent" android:layout_height="64dp"
                                android:layout_marginTop="24dp" android:orientation="horizontal">
                                <RadioButton android:id="@+id/transcript_mode" style="@style/ReferenceSetupModeButton" android:layout_width="0dp"
                                    android:layout_weight="1" android:layout_height="match_parent" android:checked="true" android:text="AI会议纪要" />
                                <RadioButton android:id="@+id/translation_mode" style="@style/ReferenceSetupModeButton" android:layout_width="0dp"
                                    android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="16dp" android:text="AI双语互译" />
                            </RadioGroup>
                            <TextView android:id="@+id/language_hint" style="@style/ReferenceSetupSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="28dp" android:text="语言" android:textSize="24sp" />
                            <LinearLayout android:id="@+id/language_selection_row" android:layout_width="match_parent" android:layout_height="56dp"
                                android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:id="@+id/source_language_container" android:layout_width="0dp" android:layout_height="match_parent"
                                    android:layout_weight="1" android:orientation="vertical" android:background="@drawable/reference_setup_input">
                                    <Spinner android:id="@+id/source_language" android:layout_width="match_parent" android:layout_height="match_parent"
                                        android:background="@null" android:spinnerMode="dropdown" android:popupBackground="@drawable/czur_ref_language_box" />
                                </LinearLayout>
                                <Button android:id="@+id/swap_languages" style="@style/ReferenceButton" android:layout_width="88dp" android:layout_height="56dp"
                                    android:background="@null" android:drawableTop="@drawable/czur_ref_swap_languages"
                                    android:contentDescription="交换会议语言" android:visibility="gone" />
                                <LinearLayout android:id="@+id/target_language_container" android:layout_width="0dp" android:layout_height="match_parent"
                                    android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:background="@drawable/reference_setup_input">
                                    <Spinner android:id="@+id/target_language" android:layout_width="match_parent" android:layout_height="match_parent"
                                        android:background="@null" android:spinnerMode="dropdown" android:popupBackground="@drawable/czur_ref_language_box" />
                                </LinearLayout>
                            </LinearLayout>
                            <ImageView android:id="@+id/translation_illustration" android:layout_width="match_parent" android:layout_height="124dp"
                                android:layout_marginTop="16dp" android:src="@drawable/czur_ref_translation_illustration" android:scaleType="fitCenter"
                                android:contentDescription="两种语言的人群分坐左右两侧" android:visibility="gone" />
                            <!-- 容器与说明随对应能力一起显示，不能只隐藏开关而留下空白的业务提示。 -->
                            <LinearLayout android:id="@+id/summary_setting" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="28dp" android:orientation="vertical">
                                <com.czur.aimeeting.reference.CzurReferenceSwitch android:id="@+id/summary_enabled" style="@style/ReferenceSetupSectionTitle"
                                    android:layout_width="match_parent" android:layout_height="48dp" android:paddingEnd="100dp"
                                    android:text="生成会议纪要" android:textSize="24sp" />
                                <TextView android:id="@+id/summary_hint" style="@style/ReferenceSetupHint" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                                    android:text="会议结束后生成内容摘要，便于会后回顾。" />
                            </LinearLayout>
                            <LinearLayout android:id="@+id/presentation_setting" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="20dp" android:orientation="vertical">
                                <com.czur.aimeeting.reference.CzurReferenceSwitch android:id="@+id/presentation_capture" style="@style/ReferenceSetupSectionTitle"
                                    android:layout_width="match_parent" android:layout_height="48dp" android:paddingEnd="100dp"
                                    android:text="演示文稿（多模态）" android:textSize="24sp" />
                                <TextView android:id="@+id/presentation_hint" style="@style/ReferenceSetupHint" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                                    android:text="将智能截取投屏内容，进行 AI 识别后，融入 AI 会议纪要。" />
                            </LinearLayout>
                            <TextView style="@style/ReferenceSetupHint" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="28dp" android:padding="20dp"
                                android:background="@drawable/reference_setup_result_hint"
                                android:text="会议中可把字幕收成右上角 Mini 悬浮窗，点击恢复原形态。" />
                        </LinearLayout>
                        <!-- 结果服务仍由插件提供，本页不写死结果类型，也不挪动插件设置入口。 -->
                        <LinearLayout android:id="@+id/result_settings_card" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical"
                            android:padding="36dp" android:background="@drawable/reference_setup_section">
                            <TextView style="@style/ReferenceSetupSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="会后结果" />
                            <TextView style="@style/ReferenceSetupHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" android:text="选择本场会议的结果查看方式" />
                            <RadioGroup android:id="@+id/result_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="24dp" />
                            <TextView android:id="@+id/result_description" style="@style/ReferenceSetupHint" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp"
                                android:background="@drawable/reference_setup_result_hint" android:text="@string/reference_result_description" />
                            <!-- 弹性留白放在说明之后：操作按钮组统一贴卡片底部。 -->
                            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                            <LinearLayout android:id="@+id/result_settings_host" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="20dp" android:orientation="vertical" />
                            <Button android:id="@+id/records_button" style="@style/ReferenceSetupSecondaryButton"
                                android:layout_width="match_parent" android:layout_height="52dp"
                                android:layout_marginTop="8dp" android:text="会议记录" />
                            <LinearLayout android:id="@+id/setup_action_slot" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="end">
                                <Button android:id="@+id/start_meeting" style="@style/ReferenceSetupPrimaryButton" android:layout_width="match_parent"
                                    android:layout_height="72dp" android:textSize="26sp" android:text="开始" android:enabled="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
                <LinearLayout android:id="@+id/setup_footer" android:layout_width="match_parent" android:layout_height="112dp"
                    android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:layout_marginEnd="32dp">
                        <TextView android:id="@+id/status" style="@style/ReferenceLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:background="@drawable/reference_setup_status_pill" android:paddingStart="18dp" android:paddingEnd="18dp"
                            android:paddingTop="10dp" android:paddingBottom="10dp"
                            android:textColor="@color/reference_setup_title" android:textSize="22sp" android:maxLines="2"
                            android:text="请先登录后开始会议" />
                        <TextView style="@style/ReferenceSetupHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="持续 5 分钟无字幕，自动停止" />
                    </LinearLayout>
                    <!-- 主操作槽已移入会后结果卡片底部；页脚只保留状态与提示。 -->
                </LinearLayout>
                <LinearLayout android:id="@+id/result_retry_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="end">
                    <Button android:id="@+id/retry_result" style="@style/ReferenceSetupPrimaryButton" android:layout_width="224dp" android:layout_height="56dp"
                        android:visibility="gone" android:text="重新打开结果" />
                    <Button android:id="@+id/end_result" style="@style/ReferenceSetupSecondaryButton" android:layout_width="224dp" android:layout_height="56dp"
                        android:layout_marginStart="16dp" android:visibility="gone" android:text="返回会前设置" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/meeting_panel" android:layout_width="1800dp" android:layout_height="1008dp"
                android:layout_gravity="center" android:orientation="vertical" android:visibility="gone"
                android:background="@drawable/czur_ref_subtitle_background" android:padding="40dp">
                <TextView android:id="@+id/meeting_title" style="@style/ReferenceDarkLabel" android:layout_width="match_parent"
                    android:layout_height="38dp" android:gravity="center" android:textSize="28sp" android:text="AI字幕纪要"/>
                <!-- 仅必要截图消息占用一条简短提示；正常会议保持国内原有的简洁布局。 -->
                <TextView android:id="@+id/presentation_notice" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center" android:textSize="20sp"
                    android:textColor="@color/reference_translation" android:visibility="gone"/>
                <FrameLayout android:id="@+id/single_controls_slot" android:layout_width="match_parent" android:layout_height="76dp">
                    <LinearLayout android:id="@+id/meeting_controls" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center">
                        <TextView android:id="@+id/elapsed" style="@style/ReferenceDarkLabel" android:layout_width="210dp"
                            android:layout_height="44dp" android:textSize="22sp" android:gravity="center" android:text="00 : 00 : 00"/>
                        <com.czur.aimeeting.reference.ui.CzurVoiceLevelView android:id="@+id/voice_level" android:layout_width="136dp" android:layout_height="44dp"/>
                        <Button android:id="@+id/swap_columns" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="交换左右显示位置" android:visibility="gone"/>
                        <Button android:id="@+id/stop_meeting" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="停止会议" android:enabled="false"/>
                        <Button android:id="@+id/overlay_button" style="@style/ReferenceButton" android:layout_width="60dp"
                            android:layout_height="60dp" android:background="@null" android:contentDescription="显示悬浮字幕"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:id="@+id/bilingual_header" android:layout_width="match_parent" android:layout_height="38dp"
                    android:orientation="horizontal" android:visibility="gone">
                    <TextView android:id="@+id/left_language_title" style="@style/ReferenceDarkLabel" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="22sp"/>
                    <Space android:layout_width="320dp" android:layout_height="match_parent"/>
                    <TextView android:id="@+id/right_language_title" style="@style/ReferenceDarkLabel" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="22sp"/>
                </LinearLayout>
                <ScrollView android:id="@+id/transcript_scroll" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/transcript_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </ScrollView>
                <LinearLayout android:id="@+id/bilingual_text_area" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
                    <ScrollView android:id="@+id/left_scroll" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                        <LinearLayout android:id="@+id/left_text_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    </ScrollView>
                    <FrameLayout android:id="@+id/bilingual_controls_slot" android:layout_width="320dp" android:layout_height="match_parent"/>
                    <ScrollView android:id="@+id/right_scroll" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
                        <LinearLayout android:id="@+id/right_text_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    </ScrollView>
                </LinearLayout>
                <!-- 原诊断控件ID保留给历史接线，主产品界面不显示开发数据。 -->
                <TextView android:id="@+id/audio_level_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <ProgressBar android:id="@+id/audio_level" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="0dp" android:max="100" android:visibility="gone"/>
                <TextView android:id="@+id/capabilities" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
