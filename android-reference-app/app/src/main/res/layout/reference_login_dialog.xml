<?xml version="1.0" encoding="utf-8"?>
<!-- 自身账号仍使用参考后端；界面摘取国内白卡、蓝标题及输入／按钮配色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/login_card"
    android:layout_width="760dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/czur_ref_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:orientation="horizontal"
        android:paddingHorizontal="40dp" android:gravity="center_vertical" android:background="@drawable/czur_ref_header">
        <TextView android:id="@+id/login_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="账号登录" android:textColor="#FFFFFF" android:textSize="36sp" android:textStyle="bold"/>
        <Button android:id="@+id/login_close" style="@style/ReferenceHeaderButton" android:layout_width="80dp"
            android:layout_height="44dp" android:text="返回"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="56dp">
        <TextView style="@style/ReferenceLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="账号"/>
        <EditText android:id="@+id/login_username" style="@style/ReferenceInput" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="终端用户账号" android:inputType="text"/>
        <TextView style="@style/ReferenceLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="密码"/>
        <EditText android:id="@+id/login_password" style="@style/ReferenceInput" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="请输入密码" android:inputType="textPassword"/>
        <TextView android:id="@+id/login_message" style="@style/ReferenceLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="20sp" android:text="使用当前部署的终端用户账号登录"/>
        <Button android:id="@+id/login_submit" style="@style/ReferenceButton" android:layout_width="180dp" android:layout_height="50dp"
            android:layout_marginTop="32dp" android:layout_gravity="center" android:text="登录"/>
    </LinearLayout>
</LinearLayout>
