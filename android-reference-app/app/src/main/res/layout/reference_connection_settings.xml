<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/reference_background">
    <LinearLayout android:layout_width="988dp" android:layout_height="720dp" android:layout_gravity="center"
        android:orientation="vertical" android:background="@drawable/czur_ref_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="54dp" android:background="@drawable/czur_ref_header">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="连接设置" android:textSize="40sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/connection_back" style="@style/ReferenceHeaderButton" android:layout_width="100dp"
                android:layout_height="46dp" android:text="返回"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical" android:paddingHorizontal="100dp" android:paddingTop="48dp">
            <TextView style="@style/ReferenceLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="会议后端地址" android:textStyle="bold"/>
            <EditText android:id="@+id/backend_url" style="@style/ReferenceInput" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="16dp" android:inputType="textUri" android:hint="@string/reference_backend_hint"/>
            <TextView style="@style/ReferenceLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:text="结果网页地址" android:textStyle="bold"/>
            <EditText android:id="@+id/web_url" style="@style/ReferenceInput" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="16dp" android:inputType="textUri" android:hint="@string/reference_web_hint"/>
            <TextView android:id="@+id/connection_message" style="@style/ReferenceLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp" android:textSize="20sp"
                android:text="填写部署后的后端与结果页地址，保存后重新登录。"/>
        </LinearLayout>
        <Button android:id="@+id/connection_save" style="@style/ReferenceButton" android:layout_width="180dp"
            android:layout_height="50dp" android:layout_gravity="center" android:layout_marginBottom="44dp" android:text="保存"/>
    </LinearLayout>
</FrameLayout>
