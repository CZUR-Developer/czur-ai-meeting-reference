<?xml version="1.0" encoding="utf-8"?>
<!-- 会议记录列表：只读历史会议，点击进入该场网页结果；不承载会议状态机。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reference_setup_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="24dp"
        android:paddingEnd="60dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/records_back"
                style="@style/ReferenceSetupBackButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="112dp"
                android:contentDescription="返回会议设置"
                android:text="返回" />

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="28dp"
                android:background="@color/reference_setup_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="会议记录"
                    android:textColor="@color/reference_setup_title"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="false"
                    android:text="查看历史会议与对应结果"
                    android:textColor="@color/reference_setup_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <Button
                android:id="@+id/records_refresh"
                style="@style/ReferenceSetupSecondaryButton"
                android:layout_width="132dp"
                android:layout_height="52dp"
                android:text="刷新" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <ScrollView
                android:id="@+id/records_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/records_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/records_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/records_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="还没有会议记录"
                    android:textColor="@color/reference_setup_title"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/records_empty_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:includeFontPadding="false"
                    android:text="开完一场会议后，记录会出现在这里"
                    android:textColor="@color/reference_setup_muted"
                    android:textSize="20sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/records_status"
                style="@style/ReferenceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/reference_setup_muted"
                android:textSize="20sp" />

            <Button
                android:id="@+id/records_load_more"
                style="@style/ReferenceSetupSecondaryButton"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:text="加载更多"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
