<?xml version="1.0" encoding="utf-8"?>
<!-- 配色／控件尺寸摘取国内transcription及base/UILib，尺寸由ReferenceUiScale适配。 -->
<resources>
    <color name="reference_blue">#5879FC</color>
    <color name="reference_background">#E8EBF7</color>
    <color name="reference_ink">#393939</color>
    <color name="reference_dark">#000B43</color>
    <color name="reference_dark_panel">#000B43</color>
    <color name="reference_translation">#FFDB10</color>
    <!-- 起始页专用中性色；不改变会中字幕、悬浮窗和登录表单的原有配色。 -->
    <color name="reference_setup_canvas">#F2F5FC</color>
    <color name="reference_setup_title">#26334D</color>
    <color name="reference_setup_muted">#68758C</color>
    <color name="reference_setup_border">#E1E7F3</color>
    <string name="reference_setup_title">AI会议纪要</string>
    <string name="reference_account">登录</string>
    <string name="reference_deployment_not_configured">部署地址未配置：请按接入文档填写本地部署配置后重新构建。</string>
    <string name="reference_source">语言</string>
    <string name="reference_target">目标语言</string>
    <string name="reference_result_description">会议结束后自动打开网页，查看本场字幕、译文及已提供的会议产物。</string>
    <!-- 会前入口为普通不透明 Activity；登录表单仍可独立使用 AlertDialog。 -->
    <style name="ReferenceMeetingActivity" parent="android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@color/reference_setup_canvas</item>
    </style>
    <style name="ReferenceLabel">
        <item name="android:textColor">@color/reference_ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="ReferenceButton" parent="android:style/Widget.Material.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/czur_ref_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ReferenceSecondaryButton" parent="ReferenceButton">
        <item name="android:background">@drawable/czur_ref_secondary_button</item>
        <item name="android:textColor">@color/reference_blue</item>
    </style>
    <style name="ReferenceHeaderButton" parent="ReferenceButton">
        <item name="android:background">#33FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="ReferenceModeButton" parent="ReferenceLabel">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/czur_ref_mode_button</item>
        <item name="android:textColor">@color/czur_ref_mode_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:buttonTint">@null</item>
    </style>
    <!-- 起始页样式独立派生，避免调整全局按钮后波及结果页与会中控制。 -->
    <style name="ReferenceSetupSectionTitle" parent="ReferenceLabel">
        <item name="android:textColor">@color/reference_setup_title</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ReferenceSetupHint" parent="ReferenceLabel">
        <item name="android:textColor">@color/reference_setup_muted</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
    <style name="ReferenceSetupPrimaryButton" parent="ReferenceButton">
        <item name="android:textSize">22sp</item>
        <item name="android:background">@drawable/reference_setup_primary_button</item>
    </style>
    <style name="ReferenceSetupSecondaryButton" parent="ReferenceSecondaryButton">
        <item name="android:background">@drawable/reference_setup_secondary_button</item>
    </style>
    <style name="ReferenceSetupBackButton" parent="ReferenceButton">
        <item name="android:background">@drawable/reference_setup_back_button</item>
        <item name="android:textColor">@color/reference_setup_muted</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:drawableStart">@drawable/ic_reference_back</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="ReferenceSetupModeButton" parent="ReferenceModeButton">
        <item name="android:background">@drawable/reference_setup_mode_button</item>
    </style>
    <style name="ReferenceDarkLabel">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="ReferenceInput" parent="ReferenceLabel">
        <item name="android:background">@drawable/czur_ref_language_box</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textColorHint">#805879FC</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
