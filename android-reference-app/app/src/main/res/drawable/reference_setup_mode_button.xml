<?xml version="1.0" encoding="utf-8"?>
<!-- 两种已有会议模式等宽呈现；选中、按下状态不改变控件尺寸。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="true">
        <shape><solid android:color="#496BE6" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_checked="true">
        <shape><solid android:color="@color/reference_blue" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#E7EDFF" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#C9D5FB" /></shape>
    </item>
    <item>
        <shape><solid android:color="#F5F7FE" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#DCE4F8" /></shape>
    </item>
</selector>
