<?xml version="1.0" encoding="utf-8"?>
<!-- 国内CZButton蓝白配色与15设计单位圆角；禁用保留颜色并降低透明度。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_enabled="false"><shape><solid android:color="#805879FC"/><corners android:radius="15dp"/></shape></item>
<item android:state_pressed="true"><shape><solid android:color="#4F6DE3"/><corners android:radius="15dp"/></shape></item>
<item><shape><solid android:color="#5879FC"/><corners android:radius="15dp"/></shape></item></selector>
